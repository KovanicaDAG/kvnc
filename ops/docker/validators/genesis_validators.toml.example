# Phase 16.6 — 4-node validator set for genesis (EXAMPLE).
# The real file is generated locally and gitignored:
#   ops/docker/validators/generate.sh
# A node's address is its raw Ed25519 public key, so address hex == public_key hex.
# Stakes = MIN_VALIDATOR_STAKE = 50_000 KVNC (50_000_000_000_000 atoms).
[[validator]]
address = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
stake = 50000000000000
public_key = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

[[validator]]
address = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
stake = 50000000000000
public_key = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

[[validator]]
address = "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
stake = 50000000000000
public_key = "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"

[[validator]]
address = "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"
stake = 50000000000000
public_key = "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"
